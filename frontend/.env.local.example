# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth (session signing) - generate with `openssl rand -base64 48`
AUTH_SESSION_SECRET=your_auth_session_secret

# Email (recruitment mails). Leave SMTP_* unset to disable sending locally.
# Google Workspace: smtp.gmail.com / 465 (needs an app password)
# Microsoft 365:    smtp.office365.com / 587 (SMTP AUTH must be enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=iraec.avyakta@pes.edu
SMTP_PASS=your_app_password
# Optional; defaults to SMTP_USER
MAIL_FROM=iraec.avyakta@pes.edu
